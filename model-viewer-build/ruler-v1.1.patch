+function bindMeasurementPointerEvents() {
+  const canvas = renderer.domElement;
+
+  canvas.addEventListener('pointerdown', (event) => {
+    measureActivePointers.add(event.pointerId);
+
+    if (!measureMode || !modelRoot || (event.pointerType === 'mouse' && event.button !== 0)) {
+      measurePointerStart = null;
+      return;
+    }
+
+    if (measureActivePointers.size === 1) {
+      measurePointerStart = {
+        pointerId: event.pointerId,
+        x: event.clientX,
+        y: event.clientY,
+        time: performance.now()
+      };
+    } else {
+      measurePointerStart = null;
+    }
+  }, { passive: true });
+
+  canvas.addEventListener('pointerup', (event) => {
+    const wasSinglePointer = measureActivePointers.size === 1;
+    measureActivePointers.delete(event.pointerId);
+
+    if (!measureMode || !modelRoot || !measurePointerStart || !wasSinglePointer) {
+      measurePointerStart = null;
+      return;
+    }
+
+    const start = measurePointerStart;
+    measurePointerStart = null;
+    if (start.pointerId !== event.pointerId) return;
+
+    const movement = Math.hypot(event.clientX - start.x, event.clientY - start.y);
+    const duration = performance.now() - start.time;
+    if (movement > 11 || duration > 650) return;
+
+    pickMeasurementPoint(event.clientX, event.clientY);
+  }, { passive: true });
+
+  canvas.addEventListener('pointercancel', (event) => {
+    measureActivePointers.delete(event.pointerId);
+    if (measurePointerStart?.pointerId === event.pointerId) measurePointerStart = null;
+  }, { passive: true });
+}
+
+function toggleMeasureMode() {
+  if (!modelRoot) {
+    showSnackbar('Сначала открой модель');
+    return;
+  }
+
+  measureMode = !measureMode;
+  setPressed(dom.measureButton, measureMode);
+  updateMeasurementUi();
+
+  if (measureMode) {
+    showSnackbar(measurementPoints.length === 0
+      ? 'Линейка включена: коснись двух точек'
+      : 'Линейка включена');
+  }
+}
+
+function pickMeasurementPoint(clientX, clientY) {
+  const rect = renderer.domElement.getBoundingClientRect();
+  if (rect.width <= 0 || rect.height <= 0) return;
+
+  measurePointer.x = ((clientX - rect.left) / rect.width) * 2 - 1;
+  measurePointer.y = -((clientY - rect.top) / rect.height) * 2 + 1;
+  measureRaycaster.setFromCamera(measurePointer, camera);
+
+  const hit = measureRaycaster
+    .intersectObject(modelRoot, true)
+    .find((intersection) => intersection.object?.visible && (intersection.object.isMesh || intersection.object.isPoints));
+
+  if (!hit) {
+    showSnackbar('Коснись поверхности модели');
+    return;
+  }
+
+  if (measurementPoints.length >= 2) clearMeasurement(false);
+  measurementPoints.push(hit.point.clone());
+  rebuildMeasurementGraphics();
+  updateMeasurementUi();
+
+  if (measurementPoints.length === 1) {
+    showSnackbar('Первая точка поставлена. Выбери вторую');
+  }
+}
+
+function clearMeasurement(updateUi = true) {
+  measurementPoints = [];
+  clearMeasurementGraphics();
+  if (updateUi) updateMeasurementUi();
+}
+
+function clearMeasurementGraphics() {
+  if (!measurementGroup) return;
+
+  while (measurementGroup.children.length > 0) {
+    const object = measurementGroup.children[measurementGroup.children.length - 1];
+    measurementGroup.remove(object);
+    object.geometry?.dispose?.();
+    const materials = Array.isArray(object.material) ? object.material : [object.material];
+    for (const material of materials) material?.dispose?.();
+  }
+}
+
+function rebuildMeasurementGraphics() {
+  clearMeasurementGraphics();
+  if (!measurementGroup || measurementPoints.length === 0 || !modelBox) return;
+
+  const modelSize = modelBox.getSize(new THREE.Vector3());
+  const radius = Math.max(modelSize.length() * 0.008, 0.00001);
+  const color = measurementColor();
+
+  for (const point of measurementPoints) {
+    const marker = new THREE.Mesh(
+      new THREE.SphereGeometry(radius, 20, 12),
+      new THREE.MeshBasicMaterial({
+        color,
+        depthTest: false,
+        depthWrite: false
+      })
+    );
+    marker.position.copy(point);
+    marker.renderOrder = 1001;
+    measurementGroup.add(marker);
+  }
+
+  if (measurementPoints.length === 2) {
+    const geometry = new THREE.BufferGeometry().setFromPoints(measurementPoints);
+    const line = new THREE.Line(
+      geometry,
+      new THREE.LineBasicMaterial({
+        color,
+        transparent: true,
+        opacity: 0.96,
+        depthTest: false,
+        depthWrite: false
+      })
+    );
+    line.renderOrder = 1000;
+    measurementGroup.add(line);
+  }
+}
+
+function measurementColor() {
+  const cssColor = getComputedStyle(document.documentElement).getPropertyValue('--primary').trim();
+  try {
+    return new THREE.Color(cssColor || '#6750a4');
+  } catch (_) {
+    return new THREE.Color('#6750a4');
+  }
+}
+
+function cycleMeasurementUnit() {
+  const index = MEASURE_UNIT_OPTIONS.indexOf(measureUnitMode);
+  measureUnitMode = MEASURE_UNIT_OPTIONS[(index + 1) % MEASURE_UNIT_OPTIONS.length];
+  updateMeasurementUi();
+}
+
+function inferModelUnit(extension) {
+  switch (String(extension || '').toLowerCase()) {
+    case 'stl':
+    case '3mf':
+    case 'amf':
+      return 'mm';
+    case 'fbx':
+      return 'cm';
+    case 'glb':
+    case 'gltf':
+    case 'dae':
+    case 'usdz':
+      return 'm';
+    default:
+      return 'unit';
+  }
+}
+
+function resolvedMeasurementUnit() {
+  return measureUnitMode === 'auto' ? modelNativeUnit : measureUnitMode;
+}
+
+function updateMeasurementUi() {
+  const unit = resolvedMeasurementUnit();
+  const label = MEASURE_UNIT_LABELS[unit] || MEASURE_UNIT_LABELS.unit;
+  dom.measureUnitButton.textContent = measureUnitMode === 'auto' ? `Авто · ${label}` : label;
+  dom.measureUnitButton.title = unit === 'unit'
+    ? 'Единицы модели не определены. Нажми, чтобы выбрать единицу'
+    : `1 единица модели считается как 1 ${label}`;
+
+  if (measurementPoints.length === 0) {
+    dom.measureValue.textContent = 'Коснись первой точки';
+    dom.measureDetail.textContent = measureMode
+      ? `Режим активен · 1 ед. модели = 1 ${label}`
+      : 'Включи линейку, чтобы поставить точки';
+  } else if (measurementPoints.length === 1) {
+    dom.measureValue.textContent = 'Коснись второй точки';
+    dom.measureDetail.textContent = `Первая точка поставлена · 1 ед. = 1 ${label}`;
+  } else {
+    const delta = measurementPoints[1].clone().sub(measurementPoints[0]);
+    const distance = delta.length();
+    dom.measureValue.textContent = `${formatMeasurementNumber(distance)} ${label}`;
+    dom.measureDetail.textContent = `ΔX ${formatMeasurementNumber(Math.abs(delta.x))} · ΔY ${formatMeasurementNumber(Math.abs(delta.y))} · ΔZ ${formatMeasurementNumber(Math.abs(delta.z))} ${label}`;
+  }
+
+  dom.measureCard.hidden = !measureMode && measurementPoints.length === 0;
+}
+
+function formatMeasurementNumber(value) {
+  const number = Math.abs(Number(value) || 0);
+  if (number === 0) return '0';
+  if (number >= 10000) return number.toLocaleString('ru-RU', { maximumFractionDigits: 1 });
+  if (number >= 1000) return number.toLocaleString('ru-RU', { maximumFractionDigits: 2 });
+  if (number >= 100) return number.toFixed(2);
+  if (number >= 10) return number.toFixed(3);
+  if (number >= 1) return number.toFixed(4);
+  if (number >= 0.001) return number.toFixed(5);
+  return number.toExponential(3).replace('.', ',');
+}
